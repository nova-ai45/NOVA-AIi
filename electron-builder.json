{
  "appId": "com.nova.ai",
  "productName": "NOVA AI",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true
  },
  "asar": true
}
