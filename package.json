{
  "name": "nova-ai",
  "version": "1.0.0",
  "description": "NOVA AI - Neural Operating Voice Assistant",
  "main": "src/main/main.js",
  "author": "NOVA Architecture Team",
  "license": "MIT",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "dev:electron": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build": "npm run build:renderer && electron-builder --win",
    "pack:dir": "npm run build:renderer && electron-builder --dir"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "msedge-tts": "^2.0.7",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
